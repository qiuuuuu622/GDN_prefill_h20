+        or checkpoint_every_n_tokens > 0
+        or os.environ.get("FLASHINFER_GDN_SM90_SPLIT", "1") == "0"
+    ):
+        return None
+    if isinstance(cu_seqlens_cpu, torch.Tensor):
+        if cu_seqlens_cpu.device.type != "cpu":
+            return None
+        offsets = cu_seqlens_cpu.tolist()
+    else:
+        offsets = [int(value) for value in cu_seqlens_cpu]
+    if (
+        len(offsets) != num_seqs + 1
+        or offsets[0] != 0
+        or offsets[-1] != total_seq_len
+    ):
+        return None
+    lengths = [end - start for start, end in zip(offsets, offsets[1:])]
+    if any(length < 0 for length in lengths):
+        return None
+    plan = _gdn_split.plan_split(lengths, num_sab_heads, sm_count)
+    return None if plan is None else (plan, lengths)
+
+
+def _run_sm90_split(
+    split_plan,
+    *,
+    q,
+    k,
+    v,
+    g,
+    beta,
+    cu_seqlens,
+    scale: float,
+    output,
+    initial_state,
+    output_state,
+) -> None:
+    plan, lengths = split_plan
+    total, heads = q.size(0), output.size(1)
+    if g is None:
+        g = torch.ones(total, heads, dtype=torch.float32, device=q.device)
+    if beta is None:
+        beta = torch.ones(total, heads, dtype=torch.float32, device=q.device)
+
+    def cp_fn(*, q, k, v, g, beta, cu_seqlens, initial_state, output_state,
