+            initial_state=initial_state, max_seqlen=max_seqlen,
+            cp_chunk_len=cp_chunk_len,
+        )
+
+    def noncp_fn(*, q, k, v, g, beta, cu_seqlens, initial_state, output_state,
+                 output, max_seqlen):
+        chunk_gated_delta_rule_sm90(
+            output, output_state, q, k, v, initial_state, g, beta, cu_seqlens,
+            scale, None, None, 0,
+        )
+
+    _gdn_split.execute_split(
+        plan,
+        lengths=lengths,
+        q=q,
+        k=k,
+        v=v,
+        g=g,
+        beta=beta,
+        cu_seqlens=cu_seqlens.to(torch.int64),
+        output=output,
+        initial_state=initial_state,
+        output_state=output_state,
+        cp_fn=cp_fn,
+        noncp_fn=noncp_fn,
+    )
